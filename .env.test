# Test Environment Variables
NODE_ENV=test

# Test Discord Configuration
TOKEN=test-token
CLIENT_ID=test-client-id
GUILD_ID=test-guild-id

# Test MongoDB (using in-memory)
MONGODB_URI=mongodb://localhost:27017/kimhunter_test

# Test Channels
REGISTRATION_CHANNEL_ID=test-registration-channel
ANNOUNCEMENT_CHANNEL_ID=test-announcement-channel
NEWS_CHANNEL_ID=test-news-channel

# Disable external services in tests
URIMAL_API_KEY=test-api-key
NEWS_API_KEY=test-news-key

# Test settings
LOG_LEVEL=error
DEV_MODE=true