    // 보스 활성화
    BOSS_SYSTEM.activeBoss = {
        ...boss,
        currentHp: boss.hp,
        spawnTime: Date.now(),
        endTime: Date.now() + BOSS_SYSTEM.spawnSettings.duration,
        channelId: channel.id
    };
    
