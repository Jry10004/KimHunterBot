                await interaction.reply({
                    content: '❌ 오류가 발생했습니다! `/버그발견`으로 신고해주세요.',
                    flags: 64
                });
            } else if (interaction.deferred) {
                await interaction.editReply({
                    content: '❌ 오류가 발생했습니다! `/버그발견`으로 신고해주세요.'
                });
            }
        } catch (replyError) {
            // 응답 실패도 무시
            console.error('오류 응답 실패:', replyError);
        }
    }
});

