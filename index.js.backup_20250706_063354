            return JSON.parse(data);
        }
    } catch (error) {
        console.error('카운트다운 상태 로드 오류:', error);
    }
    return {
        isActive: false,
        launchTime: null,
        channelId: null,
        messageId: null,
        startTime: null
    };
}

