# Discord Bot Configuration
TOKEN=your_discord_bot_token_here
CLIENT_ID=your_client_id_here
GUILD_ID=your_guild_id_here

# MongoDB Configuration
MONGODB_URI=your_mongodb_connection_string_here

# Email Configuration (for verification)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password_here
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587

# Development Mode
DEV_MODE=false
DEV_CHANNEL_IDS=channel_id1,channel_id2,channel_id3

# Channel Configuration
REGISTRATION_CHANNEL_ID=your_registration_channel_id
ANNOUNCEMENT_CHANNEL_ID=your_announcement_channel_id
NEWS_CHANNEL_ID=your_news_channel_id
EMBLEM_CHANNEL_ID=your_emblem_channel_id
PVP_CHANNEL_ID=your_pvp_channel_id
RAID_CHANNEL_ID=your_raid_channel_id

# Server Configuration
PORT=3000
LOG_LEVEL=info

# Korean Dictionary API (Required for word games)
# 국립국어원 표준국어대사전 API - 워드게임(끝말잇기, 초성게임)에 필수!
# ⚠️ 반드시 별도로 발급받아야 합니다!
#
# 📌 API 키 발급 방법:
# 1. 사이트 접속: https://stdict.korean.go.kr/openapi/openApiInfo.do
# 2. 회원가입 (이메일 인증 필요)
# 3. 로그인 후 상단 메뉴에서 "오픈API 신청" 클릭
# 4. 신청서 작성:
#    - 서비스명: 디스코드 워드게임 봇 (원하는 이름 가능)
#    - 서비스 URL: https://api.kimhunter.xyz (또는 https://kimhunter.xyz)
#    - 사용 목적: 디스코드 봇의 워드게임 단어 검증
#    - 일일 호출 한도: 10,000회 (기본값, 무료)
# 5. 신청 완료 후 1-2일 내 이메일로 승인 알림
# 6. 마이페이지에서 발급된 API 키 확인
# 7. 아래에 발급받은 키 입력 (따옴표 없이)
#
# ❗ API 키가 없으면:
# - 워드게임이 제대로 작동하지 않음
# - 대부분의 단어가 "찾을 수 없음"으로 거부됨
# - 게임이 매우 제한적으로만 작동
#
# 예시: URIMAL_API_KEY=1234567890ABCDEF1234567890ABCDEF
URIMAL_API_KEY=your_urimal_api_key

# News API Key (Optional)
# Get your API key from https://newsapi.org
# 주식 시장 뉴스 및 외부 뉴스 연동에 사용
NEWS_API_KEY=your_news_api_key
