# Discord Bot Token
TOKEN=your_discord_bot_token_here

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/kimhunter

# Email Configuration (Optional)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_SERVICE=gmail

# Channel IDs (Optional - 설정하지 않으면 해당 기능 비활성화)
EMBLEM_CHANNEL_ID=
NEWS_CHANNEL_ID=
WELCOME_CHANNEL_ID=
SIGNUP_CHANNEL_ID=

# Development Mode
DEV_MODE=false
DEV_CHANNEL_IDS=

# API Keys (Optional)
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
YOUTUBE_API_KEY=

# Server Configuration
PORT=3000
NODE_ENV=production

# Admin IDs
ADMIN_IDS=278153008930619392

# Other Settings
DEFAULT_PREFIX=!
MAX_RETRIES=3
SESSION_SECRET=your_session_secret_here