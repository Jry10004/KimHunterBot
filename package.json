{
  "name": "kimhunter-bot",
  "version": "2.0.0",
  "description": "Discord gaming bot with comprehensive features",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration",
    "test:e2e": "jest --selectProjects e2e",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "format": "prettier --write \"**/*.{js,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,json,md}\"",
    "typecheck": "tsc --noEmit",
    "validate": "npm run lint && npm run format:check && npm run test",
    "prepare": "husky install",
    "pre-commit": "lint-staged",
    "backup": "node scripts/createBackup.js",
    "db:seed": "node scripts/seedDatabase.js",
    "db:migrate": "node scripts/runMigrations.js"
  },
  "keywords": [
    "discord",
    "bot",
    "game",
    "rpg"
  ],
  "author": "KimHunter Team",
  "license": "MIT",
  "dependencies": {
    "@discordjs/rest": "^2.4.0",
    "axios": "^1.7.9",
    "crypto-js": "^4.2.0",
    "discord-api-types": "^0.37.102",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.7",
    "jimp": "^1.6.0",
    "mongoose": "^8.9.3",
    "node-cache": "^5.1.2",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.16",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/plugin-proposal-nullish-coalescing-operator": "^7.18.6",
    "@babel/plugin-proposal-optional-chaining": "^7.21.0",
    "@babel/preset-env": "^7.23.0",
    "@types/jest": "^29.5.5",
    "@types/node": "^20.8.0",
    "babel-jest": "^29.7.0",
    "eslint": "^8.51.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-jest": "^27.4.2",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "jest-html-reporter": "^3.10.2",
    "lint-staged": "^14.0.1",
    "mongodb-memory-server": "^9.0.1",
    "nock": "^13.3.4",
    "nodemon": "^3.0.1",
    "prettier": "^3.0.3",
    "typescript": "^5.2.2"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "pre-push": "npm run validate"
    }
  }
}